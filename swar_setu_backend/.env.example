# Copy to .env and fill in
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Your deployed frontend origin(s), comma separated. "*" is fine for local testing only.
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Optional: leave blank to use in-memory sessions + data/nqr_sample.json
MONGODB_URI=
MONGODB_DB=swar_setu

MAX_INTERVIEW_TURNS=12
